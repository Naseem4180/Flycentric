PORT=4000
DATABASE_URL=postgresql://flycentric:flycentric_dev_pw@localhost:5432/flycentric
JWT_ACCESS_SECRET=change_me_use_a_long_random_value
JWT_REFRESH_SECRET=change_me_use_a_different_long_random_value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
NODE_ENV=development
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated list of allowed browser origins, e.g.:
#   CORS_ORIGINS=https://app.flycentric.in,https://admin.flycentric.in
# Required in production — requests without a matching Origin are rejected.
# Left empty in development, all origins are allowed (see server.js).
CORS_ORIGINS=

# Used to build the dev-mode password reset link (see auth.js /forgot-password).
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# HMAC secret configured on the Razorpay webhook dashboard. Required in
# production — webhook requests fail closed until a valid signature can be
# checked before any payment state or entitlement is changed.
RAZORPAY_WEBHOOK_SECRET=

# Asynchronous Messaging (transactional emails via BullMQ) — see
# utils/mailQueue.js. Without this set, emails are logged instead of queued
# so local/dev setups keep working with zero extra infrastructure.
REDIS_URL=

# Object Storage (direct-to-cloud uploads) — see routes/uploads.js. Without
# these set, /api/uploads/signed-url returns 501 instead of crashing.
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Resend Email Integration (https://resend.com/onboarding) - Primary Provider
RESEND_API_KEY=
RESEND_FROM=

# Transactional Email / SMTP Configuration (Fallback: Gmail, Brevo, SendGrid, Amazon SES)
# (Can also be configured via Admin Panel -> Settings -> Email & SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM=FlyCentric Aviation <support@flycentric.in>
ADMIN_NOTIFICATION_EMAIL=support@flycentric.in
