# Local development uses http://<host>:4000/api automatically.
# For production, set this to the public Express API base URL, including /api.
# Example: https://api.example.com/api
VITE_API_URL=http://localhost:4000/api

# Google OAuth 2.0 (Direct)
VITE_GOOGLE_CLIENT_ID=

# Firebase Authentication (Google Sign-In)
# Copy from: Firebase Console -> Project Settings -> General -> Your apps -> SDK setup/config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=